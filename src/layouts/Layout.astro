---
import { Font, Image } from "astro:assets";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Nav from "../components/Nav.astro";
import { siteConfig } from "../config/site";
import type { BreadcrumbItem } from "../lib/breadcrumbs";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  headerImage?: string;
  ogImage?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description = "Turnverein Odernheim - Ihr Sportverein in Odernheim",
  headerImage = "header-bg.jpg",
  ogImage = "/images/heros/header-bg.jpg",
  breadcrumbs,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const fullTitle = `${title} | ${siteConfig.shortName}`;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Font cssVariable="--font-inter" preload />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.shortName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:locale" content="de_DE" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />

    <div class="w-full h-48 bg-primary relative overflow-hidden">
      <Image
        src={`/images/heros/${headerImage}`}
        alt=""
        class="w-full h-full object-cover"
        width={1920}
        height={480}
        widths={[960, 1280, 1600, 1920]}
        sizes="100vw"
        format="webp"
        quality={85}
        layout="none"
        priority
      />
    </div>

    <main class="flex-grow container mx-auto px-4 py-8">
      {breadcrumbs && breadcrumbs.length > 0 && (
        <Breadcrumbs items={breadcrumbs} class="mb-8" />
      )}
      <slot />
    </main>

    <footer class="bg-gray-800 text-white py-8">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-xl font-bold mb-4">{siteConfig.shortName}</h3>
            <p>{siteConfig.name}</p>
            <p>{siteConfig.address.street}</p>
            <p>{siteConfig.address.zip} {siteConfig.address.city}</p>
          </div>
          <div>
            <h3 class="text-xl font-bold mb-4">Kontakt</h3>
            <p>Email: <a href={`mailto:${siteConfig.contact.email}`} class="hover:text-accent">{siteConfig.contact.email}</a></p>
            <p>Tel: {siteConfig.contact.phone}</p>
          </div>
          <div>
            <h3 class="text-xl font-bold mb-4">Links</h3>
            <ul class="space-y-2">
              <li><a href="/impressum/" class="hover:text-accent">Impressum</a></li>
              <li><a href="/datenschutz/" class="hover:text-accent">Datenschutz</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-8 text-center">
          <p>&copy; {new Date().getFullYear()} {siteConfig.name}. Alle Rechte vorbehalten.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  html {
    background: #f6f6f6;
    background-size: 224px;
  }
  body {
    margin: 0;
    padding: 0;
  }
</style>
