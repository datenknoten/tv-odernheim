---
import {
  type Course,
  formatAgeRange,
  formatAvailability,
  formatCourseRange,
  formatFee,
} from "../lib/intelliverein";
import Button from "./Button.astro";

interface Props {
  course: Course;
}

const { course } = Astro.props;

const availability = formatAvailability(course);
const ageRange = formatAgeRange(course);
const schedule = [course.weekday, course.time].filter(Boolean).join(", ");
const fee = formatFee(course.fee);
const memberFee = formatFee(course.memberFee);

const facts: { label: string; value: string }[] = [
  { label: "Zeitraum", value: formatCourseRange(course) },
  { label: "Termin", value: schedule },
  { label: "Ort", value: [course.location, course.locationAddress].filter(Boolean).join(", ") },
  { label: "Leitung", value: course.instructor },
  { label: "Einheiten", value: course.units === null ? "" : String(course.units) },
  { label: "Alter", value: ageRange },
  {
    label: "Gebühr",
    value: memberFee && memberFee !== fee ? `${fee} (${course.memberFeeLabel}: ${memberFee})` : fee,
  },
].filter((fact) => fact.value.length > 0);
---

<article class="bg-white rounded-lg shadow-md p-6 flex flex-col h-full">
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-2xl font-bold">{course.title}</h3>
    {course.kursNr && (
      <span class="shrink-0 text-xs font-semibold text-gray-500 pt-2">{course.kursNr}</span>
    )}
  </div>

  <p
    class="mt-2 inline-flex self-start rounded bg-green-100 px-2 py-1 text-xs font-bold tracking-wide text-green-800"
  >
    {availability.toUpperCase()}
  </p>

  {course.description.length > 0 && (
    <div class="mt-4 space-y-2 text-gray-600">
      {course.description.map(paragraph => <p>{paragraph}</p>)}
    </div>
  )}

  <dl class="mt-4 space-y-1 text-sm">
    {facts.map(fact => (
      <div class="flex gap-2">
        <dt class="w-24 shrink-0 font-semibold text-gray-500">{fact.label}</dt>
        <dd>{fact.value}</dd>
      </div>
    ))}
  </dl>

  <div class="mt-auto flex flex-wrap items-center gap-4 pt-6">
    <Button href={course.bookingUrl} variant="accent" size="sm">Jetzt anmelden</Button>
    {course.infoUrl && (
      <Button href={course.infoUrl} variant="link">Mehr Informationen</Button>
    )}
    {course.termsUrl && (
      <Button href={course.termsUrl} variant="link">Teilnahmebedingungen</Button>
    )}
  </div>
</article>
