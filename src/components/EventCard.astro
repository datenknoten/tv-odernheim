---
import type { CollectionEntry } from "astro:content";
import { eventDateTimeAttribute, formatEventDateTime } from "../lib/events";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  event: CollectionEntry<"events">;
  compact?: boolean;
}

const { event, compact = false } = Astro.props;
const dateLabel = formatEventDateTime(event);
const dateTimeAttr = eventDateTimeAttribute(event);
const isCancelled = event.data.status === "abgesagt";
---

<a
  href={`/termine/${event.id}`}
  class={`block bg-white rounded-lg shadow-md p-5 hover:shadow-lg transition-shadow ${isCancelled ? "opacity-75" : ""}`}
>
  <div class="flex items-start justify-between gap-3 mb-2">
    <time class="text-sm font-semibold text-primary" datetime={dateTimeAttr}>{dateLabel}</time>
    <StatusBadge status={event.data.status} />
  </div>
  <h3 class={`font-bold mb-1 ${compact ? "text-lg" : "text-xl"} ${isCancelled ? "line-through" : ""}`}>
    {event.data.title}
  </h3>
  {!compact && (
    <p class="text-gray-600 text-sm mb-2">{event.data.description}</p>
  )}
  {event.data.location && (
    <p class="text-sm text-gray-500 flex items-center">
      <svg class="w-4 h-4 mr-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      {event.data.location}
    </p>
  )}
</a>
