---
interface Props {
	eyebrow?: string;
	title: string;
	lede?: string;
	class?: string;
}

const { eyebrow, title, lede, class: className = "" } = Astro.props;
---

<section
	class:list={[
		"mb-12 max-w-3xl border-l-4 border-accent pl-6 md:pl-8",
		className,
	]}
>
	{
		eyebrow && (
			<p class="mb-3 text-sm font-semibold uppercase tracking-widest text-accent">
				{eyebrow}
			</p>
		)
	}
	<h1 class="text-4xl md:text-5xl font-bold leading-tight text-primary">
		{title}
	</h1>
	{
		lede && (
			<p class="mt-4 text-xl md:text-2xl text-gray-600 leading-relaxed">
				{lede}
			</p>
		)
	}
	<slot />
</section>
