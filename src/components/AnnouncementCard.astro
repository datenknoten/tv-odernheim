---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Button from "./Button.astro";

interface Props {
	announcement: CollectionEntry<"announcements">;
	compact?: boolean;
}

const { announcement, compact = false } = Astro.props;
const { title, description, image, category, ctaLabel, ctaUrl } = announcement.data;
const detailHref = `/mitmachen/${announcement.id}`;

const categoryLabels = {
	Mitmachen: "Mitmachen & Helfen",
	Angebot: "Angebot",
	Hinweis: "Hinweis",
} as const;

const categoryClasses = {
	Mitmachen: "bg-primary/10 text-primary",
	Angebot: "bg-accent/15 text-accent",
	Hinweis: "bg-gray-100 text-gray-600",
} as const;
---

<article class="bg-white rounded-lg shadow-md overflow-hidden flex flex-col">
  {image ? (
    <Image
      src={image}
      alt={title}
      width={800}
      height={450}
      class="w-full aspect-[16/9] object-cover"
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      format="webp"
      quality={80}
    />
  ) : (
    <div
      class="w-full aspect-[16/9] bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center"
      aria-hidden="true"
    >
      <img
        src="/images/tvo-logo-red.png"
        alt=""
        width="72"
        height="72"
        class="opacity-40"
        loading="lazy"
      />
    </div>
  )}
  <div class={`p-6 flex flex-col flex-1 ${compact ? "space-y-2" : ""}`}>
    <span class={`self-start text-xs font-semibold uppercase tracking-wide px-2 py-0.5 rounded mb-2 ${categoryClasses[category]}`}>
      {categoryLabels[category]}
    </span>
    <h3 class={`font-bold mb-2 ${compact ? "text-xl" : "text-2xl"}`}>{title}</h3>
    <p class="text-gray-600 mb-4 flex-1">{description}</p>
    <div class="flex flex-wrap gap-3">
      {ctaLabel && ctaUrl && (
        <Button href={ctaUrl} size="sm" class="self-start">{ctaLabel}</Button>
      )}
      <Button href={detailHref} variant="link" class="self-start">Mehr erfahren →</Button>
    </div>
  </div>
</article>
