---
interface Props {
  attachments: { file: string; label: string }[];
  title?: string;
}

const { attachments, title = "Dateien" } = Astro.props;

// Keystatic legt Anhaenge unter <slug>/attachments/<index>/file.<ext> ab; der
// Dateiname ist also nicht sprechend. Angezeigt wird deshalb die Beschriftung
// (ersatzweise der Dateiname), und das download-Attribut benennt die Datei
// beim Herunterladen nach der Beschriftung.
const items = attachments
  .filter((attachment) => attachment.file)
  .map((attachment) => {
    const fileName = decodeURIComponent(attachment.file.split("/").pop() ?? attachment.file);
    const extension = fileName.includes(".") ? (fileName.split(".").pop() ?? "") : "";
    const label = attachment.label.trim();
    const downloadName = label
      .normalize("NFKD")
      .replace(/[^\w\s-]/g, "")
      .trim()
      .replace(/\s+/g, "-")
      .toLowerCase();
    return {
      href: attachment.file,
      label: label || fileName,
      extension: extension.toUpperCase(),
      downloadName: downloadName ? `${downloadName}${extension ? `.${extension}` : ""}` : fileName,
    };
  });
---

{items.length > 0 && (
  <section class="mt-10">
    <h2 class="text-2xl font-bold mb-4">{title}</h2>
    <ul class="list-none m-0 p-0 space-y-2">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            download={item.downloadName}
            class="flex items-center gap-3 rounded border border-gray-200 bg-white px-4 py-3 hover:border-accent hover:text-primary"
          >
            <span class="shrink-0 rounded bg-gray-100 px-2 py-1 text-xs font-bold tracking-wide text-gray-600">
              {item.extension || "DATEI"}
            </span>
            <span class="font-semibold">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
