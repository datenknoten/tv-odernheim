---
import { getCollection } from "astro:content";
import AnnouncementCard from "../components/AnnouncementCard.astro";
import EventCard from "../components/EventCard.astro";
import Layout from "../layouts/Layout.astro";
import { partitionEvents } from "../lib/events";

const newsEntries = await getCollection("news");
const sortedNews = newsEntries.sort(
	(a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const allEvents = await getCollection("events");
const { upcoming: upcomingEvents } = partitionEvents(allEvents);
const homepageEvents = upcomingEvents.slice(0, 4);

const announcements = await getCollection("announcements");
const homepageAnnouncements = announcements
	.toSorted((a, b) => a.data.sortierung - b.data.sortierung)
	.slice(0, 3);
---

<Layout title="Startseite">
  <section class="hero bg-primary text-white py-16 rounded-lg mb-12">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Willkommen beim TV Odernheim</h1>
      <p class="text-xl mb-8">Ihr Sportverein in Odernheim - Gemeinsam aktiv und fit bleiben</p>
      <a href="/kurse" class="bg-accent hover:bg-accent-dark text-white font-bold py-3 px-6 rounded-lg transition-colors">
        Zu unseren Kursen
      </a>
    </div>
  </section>

  {homepageEvents.length > 0 && (
    <section class="mb-12">
      <div class="flex items-baseline justify-between mb-6 flex-wrap gap-2">
        <h2 class="text-3xl font-bold">Nächste Termine</h2>
        <a href="/termine" class="text-primary hover:text-secondary font-semibold">Alle Termine →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {homepageEvents.map((event) => <EventCard event={event} compact />)}
      </div>
    </section>
  )}

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-6">Aktuelle Nachrichten</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedNews.map((news) => (
        <article class="bg-white p-6 rounded-lg shadow-md">
          <h3 class="text-xl font-bold mb-2">{news.data.title}</h3>
          <p class="text-gray-600 mb-4">{news.data.description}</p>
          <a href={`/news/${news.id}`} class="text-primary hover:text-secondary">Mehr erfahren →</a>
        </article>
      ))}
    </div>
  </section>

  {homepageAnnouncements.length > 0 && (
    <section class="mb-12">
      <div class="flex items-baseline justify-between mb-6 flex-wrap gap-2">
        <h2 class="text-3xl font-bold">Mitmachen & Hinweise</h2>
        <a href="/mitmachen" class="text-primary hover:text-secondary font-semibold">Alle Hinweise →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {homepageAnnouncements.map((item) => (
          <AnnouncementCard announcement={item} compact />
        ))}
      </div>
    </section>
  )}

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-6">Über den TV Odernheim</h2>
    <div class="bg-white p-6 rounded-lg shadow-md">
      <p class="text-gray-700 mb-4">
        Der Turnverein Odernheim ist Ihr Sportverein in Odernheim. Wir bieten ein breites Spektrum an Sportkursen für alle Altersgruppen an.
        Ob Sie sich fit halten, neue Sportarten ausprobieren oder einfach Spaß haben möchten - bei uns sind Sie genau richtig!
      </p>
      <p class="text-gray-700">
        Unser erfahrenes Team von Trainern steht Ihnen mit Rat und Tat zur Seite und freut sich darauf, Sie kennenzulernen.
      </p>
    </div>
  </section>
</Layout>
