---
import { getCollection } from "astro:content";
import AnnouncementCard from "../components/AnnouncementCard.astro";
import Button from "../components/Button.astro";
import FeedCard from "../components/FeedCard.astro";
import Hero from "../components/Hero.astro";
import Layout from "../layouts/Layout.astro";
import { getFeed } from "../lib/feed";

const feed = await getFeed();
const homepageFeed = feed.slice(0, 6);

const announcements = await getCollection("announcements");
const homepageAnnouncements = announcements
  .toSorted((a, b) => a.data.sortierung - b.data.sortierung)
  .slice(0, 3);
---

<Layout title="Startseite">
  <Hero
    title="Willkommen beim TV Odernheim"
    lede="Ihr Sportverein in Odernheim - Gemeinsam aktiv und fit bleiben"
  >
    <div class="mt-8">
      <Button href="/kurse" variant="accent">Zu unseren Kursen</Button>
    </div>
  </Hero>

  {homepageFeed.length > 0 && (
    <section class="mb-12">
      <div class="flex items-baseline justify-between mb-6 flex-wrap gap-2">
        <h2 class="text-3xl font-bold">Aktuelles</h2>
        <Button href="/aktuelles" variant="link">Alle anzeigen →</Button>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {homepageFeed.map((item) => <FeedCard item={item} />)}
      </div>
    </section>
  )}

  {homepageAnnouncements.length > 0 && (
    <section class="mb-12">
      <div class="flex items-baseline justify-between mb-6 flex-wrap gap-2">
        <h2 class="text-3xl font-bold">Mitmachen & Hinweise</h2>
        <Button href="/mitmachen" variant="link">Alle Hinweise →</Button>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {homepageAnnouncements.map((item) => (
          <AnnouncementCard announcement={item} compact />
        ))}
      </div>
    </section>
  )}

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-6">Über den TV Odernheim</h2>
    <div class="bg-white p-6 rounded-lg shadow-md">
      <p class="text-gray-700 mb-4">
        Der Turnverein Odernheim ist Ihr Sportverein in Odernheim. Wir bieten ein breites Spektrum an Sportkursen für alle Altersgruppen an.
        Ob Sie sich fit halten, neue Sportarten ausprobieren oder einfach Spaß haben möchten - bei uns sind Sie genau richtig!
      </p>
      <p class="text-gray-700">
        Unser erfahrenes Team von Trainern steht Ihnen mit Rat und Tat zur Seite und freut sich darauf, Sie kennenzulernen.
      </p>
    </div>
  </section>
</Layout>
