---
import Button from "../components/Button.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { siteConfig } from "../config/site";
import Layout from "../layouts/Layout.astro";

const mail = `mailto:${siteConfig.contact.email}?subject=${encodeURIComponent("Sportabzeichen")}`;
const linkClass = "font-semibold text-primary hover:text-secondary";
---

<Layout
  title="Sportabzeichen"
  description="Das Deutsche Sportabzeichen beim TV Odernheim: jedes Frühjahr Training und Abnahme für Mitglieder und Nichtmitglieder ab 6 Jahren."
  breadcrumbs={[
    { label: "Startseite", href: "/" },
    { label: "Sportabzeichen" },
  ]}
>
  <Hero
    eyebrow="Deutsches Sportabzeichen"
    title="Sportabzeichen beim TVO"
    lede="Das Deutsche Sportabzeichen ist die Auszeichnung des Deutschen Olympischen Sportbundes (DOSB) für vielseitige körperliche Leistungsfähigkeit. Beim TV Odernheim trainieren wir jedes Frühjahr gemeinsam dafür und nehmen die Prüfungen ab – für Mitglieder und Nichtmitglieder."
  >
    <div class="mt-8">
      <Button href={mail} variant="accent">Fragen per E-Mail</Button>
    </div>
  </Hero>

  <section class="mb-12">
    <SectionHeading title="So funktioniert's" class="mb-6" />
    <div class="bg-white p-6 rounded-lg shadow-md">
      <ul class="list-disc list-inside text-gray-700 space-y-2">
        <li>
          Du legst innerhalb eines Kalenderjahres in vier Gruppen je eine Übung ab:{" "}
          <strong>Ausdauer, Kraft, Schnelligkeit und Koordination</strong>.
        </li>
        <li>
          Jede Übung zählt in Bronze 1, in Silber 2 und in Gold 3 Punkte. Mit 4 bis 7 Punkten
          erhältst du das Sportabzeichen in Bronze, mit 8 bis 10 in Silber, mit 11 oder 12 in Gold.
        </li>
        <li>
          Dazu kommt ein <strong>Schwimmnachweis</strong>. Für Erwachsene gilt er fünf Jahre, für
          Kinder und Jugendliche genügt er einmal.
        </li>
        <li>
          Mitmachen können Kinder ab dem Jahr, in dem sie 6 werden. Ab dem Jahr, in dem du 18
          wirst, legst du das Sportabzeichen für Erwachsene ab.
        </li>
        <li>
          Die Anforderungen richten sich nach Alter und Geschlecht. Du findest sie im{" "}
          <a class={linkClass} href="https://deutsches-sportabzeichen.de/materialien" rel="noopener" target="_blank">Leistungskatalog des DOSB</a>.
        </li>
      </ul>
    </div>
  </section>

  <section class="mb-12">
    <SectionHeading title="Training und Abnahme beim TVO" class="mb-6" />
    <div class="bg-white p-6 rounded-lg shadow-md">
      <ul class="list-disc list-inside text-gray-700 space-y-2 mb-4">
        <li>
          <strong>Erwachsene:</strong> Jedes Frühjahr ab Ende April trainieren wir gemeinsam auf dem
          Außengelände des TVO und nehmen dort die Prüfungen ab.
        </li>
        <li>
          <strong>Kinder und Jugendliche ab 6 Jahren:</strong> Training und Abnahme auf dem
          Außengelände des TVO.
        </li>
        <li>
          <strong>Schwimmen:</strong> Die Schwimmabnahme findet im Schwimmbad des
          Paul-Schneider-Gymnasiums in Meisenheim (Präses-Held-Straße) statt – einmal während der
          Trainingszeit und ein Nachholtermin im Dezember. Kinder können dort auch das Seepferdchen
          ablegen. Bitte melde dich dafür <a class={linkClass} href={mail}>per E-Mail</a> an.
        </li>
      </ul>
      <p class="text-gray-700">
        Die genauen Termine findest du unter <a class={linkClass} href="/aktuelles/">Aktuelles</a>.
      </p>
    </div>
  </section>

  <section class="mb-12">
    <SectionHeading title="Verleihung" class="mb-6" />
    <div class="bg-white p-6 rounded-lg shadow-md">
      <p class="text-gray-700">
        Die Sportabzeichen eines Jahres verleihen wir im Januar beim Neujahrsempfang auf dem
        Außengelände hinter der Turnhalle – mit Glühwein, Punsch und Grillwürstchen.
      </p>
    </div>
  </section>

  <section class="bg-gray-100 p-6 rounded-lg">
    <h2 class="text-2xl font-bold mb-4">Kontakt</h2>
    <p class="text-gray-700 mb-2">
      Geschäftszimmer des {siteConfig.shortName}, {siteConfig.address.street},{" "}
      {siteConfig.address.zip} {siteConfig.address.city}
    </p>
    <p class="text-gray-700 mb-2">
      Telefon {siteConfig.contact.phone} · E-Mail <a class={linkClass} href={mail}>{siteConfig.contact.email}</a>
    </p>
    <p class="text-gray-700">Besetzt mittwochs von 10:00 bis 12:00 Uhr.</p>
  </section>
</Layout>
