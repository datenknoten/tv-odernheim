---
import fs from "node:fs";
import path from "node:path";
import Button from "../components/Button.astro";
import Hero from "../components/Hero.astro";
import { siteConfig } from "../config/site";
import Layout from "../layouts/Layout.astro";

interface Point {
  lat: number;
  lon: number;
}
const trkptRegex = /<trkpt\s+lat="([\d.]+)"\s+lon="([\d.]+)"/g;
const earthRadiusKm = 6371;

interface Route {
  key: string;
  label: string;
  sublabel: string;
  latLngs: (readonly [number, number])[];
  distanceLabel: string;
  gpxUrl: string;
}

function loadRoute(def: {
  key: string;
  label: string;
  sublabel: string;
  file: string;
}): Route | null {
  const filePath = path.resolve(process.cwd(), "public/disibodenberglauf", def.file);
  if (!fs.existsSync(filePath)) {
    return null;
  }
  const gpxRaw = fs.readFileSync(filePath, "utf-8");
  const points: Point[] = [];
  for (const match of gpxRaw.matchAll(trkptRegex)) {
    points.push({ lat: Number.parseFloat(match[1]), lon: Number.parseFloat(match[2]) });
  }
  if (points.length === 0) {
    return null;
  }

  let distanceKm = 0;
  for (let i = 1; i < points.length; i++) {
    const a = points[i - 1];
    const b = points[i];
    const dLat = ((b.lat - a.lat) * Math.PI) / 180;
    const dLon = ((b.lon - a.lon) * Math.PI) / 180;
    const lat1 = (a.lat * Math.PI) / 180;
    const lat2 = (b.lat * Math.PI) / 180;
    const h = Math.sin(dLat / 2) ** 2 + Math.sin(dLon / 2) ** 2 * Math.cos(lat1) * Math.cos(lat2);
    distanceKm += 2 * earthRadiusKm * Math.asin(Math.sqrt(h));
  }

  return {
    key: def.key,
    label: def.label,
    sublabel: def.sublabel,
    latLngs: points.map((p) => [p.lat, p.lon] as const),
    distanceLabel: distanceKm.toFixed(1).replace(".", ","),
    gpxUrl: `/disibodenberglauf/${def.file}`,
  };
}

const routeDefs = [
  { key: "haupt", label: "Hauptlauf", sublabel: "5 / 10 km · W/M ab 16", file: "strecke.gpx" },
  { key: "bambini", label: "Bambini", sublabel: "200 m · Jg. 2021 u. j.", file: "bambini.gpx" },
  { key: "kinder", label: "Kinder", sublabel: "500 m · W/M 6/7", file: "kinder.gpx" },
  { key: "kinder1km", label: "Kinder", sublabel: "1 km · W/M 8–11", file: "kinder1km.gpx" },
  { key: "jugend", label: "Jugend", sublabel: "2 km · W/M 12–15", file: "jugend.gpx" },
];

const routes = routeDefs.map(loadRoute).filter((r): r is Route => r !== null);
const activeRouteKey = routes[0]?.key ?? "haupt";
const streckeDistanceLabel = routes[0]?.distanceLabel ?? "";

const streckenrekorde = [
  { strecke: "5 km", name: "Maria Schubert", zeit: "0:20:48", datum: "2005" },
  { strecke: "5 km", name: "Gunter Glaß", zeit: "0:17:48", datum: "2004" },
  { strecke: "10 km", name: "Grete Tönne", zeit: "0:40:44", datum: "20.09.2012" },
  { strecke: "10 km", name: "Fabian Fiedler", zeit: "0:34:54", datum: "12.10.2024" },
];

const sonderpreise = [
  {
    titel: "Knack den Rekord",
    text: "Seit dem Jahr 2000 wird der Lauf in der heutigen Streckenführung ausgetragen. Um Spitzenläuferinnen und Spitzenläufer zusätzlich zu motivieren, vergeben wir den Sonderpreis „Knack den Streckenrekord“ für neue Bestzeiten. Wer eine der bestehenden Bestmarken unterbietet, erhält bei der Siegerehrung eine besondere Auszeichnung.",
    image: "/images/disibodenberglauf/schnuersenkel.jpeg",
    imageAlt: "Läuferin schnürt vor dem Start ihre Laufschuhe",
  },
  {
    titel: "Lauft als Familie",
    text: "Die Familie mit den meisten teilnehmenden Mitgliedern wird als „Laufmutigste Disibo-Familie“ ausgezeichnet und erhält einen Sonderpreis. Wichtig: Bitte bei der Anmeldung das Kästchen „Familienwettbewerb“ ankreuzen und einen gemeinsamen Familiennamen angeben. Teilnahmeberechtigt sind direkte Verwandte: Großeltern, Eltern, Kinder, Enkel, Urenkel, Geschwister sowie Schwager und Schwägerinnen.",
    image: "/images/disibodenberglauf/laufschuhe.jpeg",
    imageAlt: "Mehrere Läuferinnen und Läufer gemeinsam auf der Strecke",
  },
  {
    titel: "Team an den Start",
    text: "Der Verein, die Organisation oder die Schule mit den meisten Teilnehmenden erhält den Sonderpreis „Größtes Team im Rennen“. Voraussetzung für die Wertung ist, dass bei der Online-Anmeldung derselbe Vereins-, Organisations- oder Schulname angegeben wird. Je mehr Teilnehmende gemeldet sind, desto größer sind die Chancen auf den Sonderpreis.",
    image: "/images/disibodenberglauf/wettkampf.jpeg",
    imageAlt: "Zwei Läufer mit Startnummern im engen Rennen",
  },
  {
    titel: "Walk & Talk",
    text: "Gute Laune gehört dazu: Die „Fröhlichste Walk-&-Talk-Gruppe“ erhält ebenfalls einen Sonderpreis. Im Mittelpunkt stehen dabei nicht die Zeiten, sondern Spaß und gemeinsames Unterwegssein.",
    image: "/images/disibodenberglauf/nordic-walking.jpeg",
    imageAlt: "Gruppe beim Nordic Walking auf einem Waldweg",
  },
];

const anmeldungUrl = "https://my.raceresult.com/325942/info";
const streckeUrl = "https://out.ac/IhEjiO";
const streckeKomootUrl = "https://www.komoot.com/tour/2965244888";
const streckeGpxUrl = "/disibodenberglauf/strecke.gpx";
const anmeldungMail = `mailto:${siteConfig.contact.email}?subject=${encodeURIComponent("Anmeldung 38. Disibodenberglauf")}`;
---

<Layout
  title="Disibodenberglauf"
  description="38. Disibodenberglauf am 19. September 2026 in Odernheim am Glan – landschaftlich reizvoll, familiär und mit tollen Sonderpreisen."
  breadcrumbs={[
    { label: "Startseite", href: "/" },
    { label: "Disi-Lauf" },
  ]}
>
  <Hero eyebrow="38. Disibodenberglauf" title="Rock den Disi '26">
    <p class="mt-4 text-xl text-gray-600 leading-relaxed">
      Sportlich, familiär und mit tollen Sonderpreisen – am <strong>Samstag, 19. September 2026
      ab 15:00 Uhr</strong> führt der Disibodenberglauf wieder rund um den geschichtsträchtigen
      Berg über Odernheim.
    </p>
    <img
      slot="media"
      src="/images/disibodenberglauf/logo.jpeg"
      alt="Logo „Rock den Disi '26“ – zwei Läufer-Silhouetten vor Hügellandschaft"
      width="1320"
      height="1320"
      class="w-full md:w-56 h-auto"
      loading="eager"
    />
  </Hero>

  <section class="mb-12">
    <div class="bg-white p-6 rounded-lg shadow-md grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-primary mb-2">Termin</h2>
        <p class="text-lg font-bold">Samstag, 19. September 2026</p>
        <p class="text-gray-600 text-sm">ab 15:00 Uhr</p>
      </div>
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-primary mb-2">Start &amp; Ziel</h2>
        <p class="text-lg font-bold">Turnhalle Odernheim</p>
        <p class="text-gray-600 text-sm">{siteConfig.address.street}, {siteConfig.address.zip} {siteConfig.address.city}</p>
      </div>
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-primary mb-2">Veranstalter</h2>
        <p class="text-lg font-bold">{siteConfig.shortName}</p>
        <p class="text-gray-600 text-sm">Turnverein Odernheim am Glan 1890 e. V.</p>
      </div>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-6">Vorbereitungsläufe</h2>
    <div class="bg-white p-6 rounded-lg shadow-md">
      <p class="text-gray-700 mb-2">
        An drei Mittwochabenden vor dem Lauf laufen wir gemeinsam Teile der Strecke.
        Treffpunkt ist jeweils an der Turnhalle.
      </p>
      <ul class="list-disc list-inside text-gray-700 space-y-1">
        <li>Mittwoch, 02. September 2026 – ab 18:30 Uhr</li>
        <li>Mittwoch, 09. September 2026 – ab 18:30 Uhr</li>
        <li>Mittwoch, 16. September 2026 – ab 18:30 Uhr</li>
      </ul>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-6">Die Strecke</h2>
    <div class="bg-white p-6 rounded-lg shadow-md">
      <p class="text-gray-700 mb-4">
        Der Disibodenberglauf verbindet eine landschaftlich reizvolle Strecke entlang des Glans
        mit dem anspruchsvollen Anstieg auf den Eselspfad. Diese Kombination aus flachen
        Abschnitten und Trailpassagen prägt den Charakter des Laufs.
      </p>
      <p class="text-gray-700 mb-4">
        In seiner heutigen Streckenführung wird der Lauf seit dem Jahr 2000 vom Turnverein
        Odernheim am Glan e. V. veranstaltet. Bereits zuvor gab es einen Volkslauf auf anderen
        Routen, sodass der Disibodenberglauf im Jahr 2026 bereits zum 38. Mal stattfindet.
      </p>
      <p class="text-gray-700 mb-6">
        Angeboten werden 5- und 10-km-Läufe, Walking auf der 5-km-Strecke sowie Wettbewerbe für
        Bambini, Kinder und Jugendliche.
      </p>

      {/* Map tiles are served from public/tiles/ — regenerate via `npm run cache-tiles`. */}
      {routes.length > 1 && (
        <div class="flex flex-wrap gap-2 mb-4" role="tablist" aria-label="Strecke auswählen">
          {routes.map((r) => (
            <button
              type="button"
              role="tab"
              data-route-key={r.key}
              aria-selected={r.key === activeRouteKey ? "true" : "false"}
              class="strecke-tab text-left font-semibold py-2 px-4 rounded border border-primary transition-colors aria-selected:bg-primary aria-selected:text-white text-primary bg-white hover:bg-primary hover:text-white"
            >
              <span class="flex flex-col leading-tight">
                <span>{r.label}</span>
                <span class="text-xs font-normal opacity-80">{r.sublabel}</span>
              </span>
            </button>
          ))}
        </div>
      )}
      <figure class="mb-6">
        <div
          id="strecke-map"
          class="bg-gray-100 border border-gray-200 rounded-lg w-full h-96"
          role="img"
          aria-label={`Streckenverlauf, ca. ${streckeDistanceLabel} km`}
          data-routes={JSON.stringify(routes)}
          data-active={activeRouteKey}
        ></div>
        <figcaption class="text-sm text-gray-500 mt-2">
          Streckenverlauf, ca. <span id="strecke-distance">{streckeDistanceLabel}</span> km. Kartenkacheln ©{" "}
          <a
            href="https://www.openstreetmap.org/copyright"
            class="underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            OpenStreetMap-Mitwirkende
          </a>{" "}
          – lokal gehostet, keine externen Anfragen zur Laufzeit.
        </figcaption>
      </figure>

      <script>
        import L from "leaflet";
        import "leaflet/dist/leaflet.css";

        type Route = {
          key: string;
          label: string;
          sublabel: string;
          latLngs: [number, number][];
          distanceLabel: string;
          gpxUrl: string;
        };

        const el = document.getElementById("strecke-map");
        if (el?.dataset.routes) {
          const mapEl = el;
          const routes = JSON.parse(mapEl.dataset.routes ?? "[]") as Route[];
          const byKey = new Map(routes.map((r) => [r.key, r]));
          const map = L.map(el, {
            scrollWheelZoom: false,
            minZoom: 13,
            maxZoom: 17,
          });
          L.tileLayer("/tiles/{z}/{x}/{y}.png", {
            minZoom: 13,
            maxZoom: 17,
            attribution:
              '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          }).addTo(map);

          let routeLine: L.Polyline | null = null;
          let startMarker: L.CircleMarker | null = null;
          const distanceEl = document.getElementById("strecke-distance");
          const downloadEl = document.getElementById(
            "strecke-gpx-download",
          ) as HTMLAnchorElement | null;
          const tabs = Array.from(
            document.querySelectorAll<HTMLButtonElement>(".strecke-tab"),
          );

          const routeColor =
            getComputedStyle(document.documentElement)
              .getPropertyValue("--color-accent")
              .trim() || "#e53e3e";

          function selectRoute(key: string) {
            const route = byKey.get(key);
            if (!route) return;

            if (routeLine) routeLine.remove();
            if (startMarker) startMarker.remove();

            routeLine = L.polyline(route.latLngs, {
              color: routeColor,
              weight: 4,
              opacity: 0.85,
            }).addTo(map);
            startMarker = L.circleMarker(route.latLngs[0], {
              radius: 7,
              color: "#ffffff",
              weight: 2,
              fillColor: "#16a34a",
              fillOpacity: 1,
            }).addTo(map);
            map.fitBounds(routeLine.getBounds(), { padding: [16, 16] });

            if (distanceEl) distanceEl.textContent = route.distanceLabel;
            if (downloadEl) {
              downloadEl.href = route.gpxUrl;
              downloadEl.download = `disibodenberglauf-2026-${route.key}.gpx`;
            }
            mapEl.setAttribute("aria-label", `Streckenverlauf, ca. ${route.distanceLabel} km`);
            for (const tab of tabs) {
              tab.setAttribute(
                "aria-selected",
                tab.dataset.routeKey === key ? "true" : "false",
              );
            }
          }

          for (const tab of tabs) {
            tab.addEventListener("click", () => {
              if (tab.dataset.routeKey) selectRoute(tab.dataset.routeKey);
            });
          }

          selectRoute(el.dataset.active ?? routes[0]?.key ?? "");
        }
      </script>

      <div class="flex flex-wrap gap-3">
        <Button href={streckeUrl} size="sm" rel="noopener" target="_blank">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.553 2.776A1 1 0 0022 18.882V8.118a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
          Strecke auf Outdooractive
        </Button>
        <a
          href={streckeKomootUrl}
          class="inline-flex items-center gap-2 bg-white border border-primary text-primary hover:bg-primary hover:text-white font-bold py-2 px-4 rounded transition-colors"
          rel="noopener"
          target="_blank"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.553 2.776A1 1 0 0022 18.882V8.118a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
          Strecke auf Komoot
        </a>
        <a
          id="strecke-gpx-download"
          href={streckeGpxUrl}
          class="inline-flex items-center gap-2 bg-white border border-primary text-primary hover:bg-primary hover:text-white font-bold py-2 px-4 rounded transition-colors"
          download="disibodenberglauf-2026.gpx"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V4" />
          </svg>
          GPX herunterladen
        </a>
      </div>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-6">Siegerehrung &amp; Verpflegung</h2>
    <div class="bg-white p-6 rounded-lg shadow-md">
      <p class="text-gray-700 mb-4">
        Die Siegerehrung findet in der Turnhalle statt. Dort gibt es für Teilnehmende und
        Zuschauer Kaffee, selbstgebackenen Kuchen und Grillgut zu fairen Preisen.
      </p>
      <p class="text-gray-700">
        Auch in diesem Jahr werden wieder Sonderpreise vergeben. Zusätzlich ehren wir die
        Erstplatzierten der einzelnen Läufe sowie die Kinder in ihren Altersklassen.
      </p>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-2">Unsere neuen Sonderpreise</h2>
    <p class="text-gray-600 mb-6">Vier Gründe extra, beim 38. Disibodenberglauf dabei zu sein:</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {sonderpreise.map((p) => (
        <article class="bg-white rounded-lg shadow-md flex flex-col overflow-hidden">
          {p.image && (
            <img
              src={p.image}
              alt={p.imageAlt}
              width="800"
              height="450"
              class="w-full aspect-[16/9] object-cover"
              loading="lazy"
            />
          )}
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2 text-primary">{p.titel}</h3>
            <p class="text-gray-700">{p.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-6">Impressionen vom letzten Jahr</h2>
    <div class="bg-white p-6 rounded-lg shadow-md">
      <video
        controls
        preload="metadata"
        playsinline
        class="w-full h-auto rounded-lg"
        aria-label="Impressionen vom Disibodenberglauf im Vorjahr"
      >
        <source src="/disibodenberglauf/disi-lauf.mp4" type="video/mp4" />
        <track
          kind="captions"
          src="/disibodenberglauf/disi-lauf.de.vtt"
          srclang="de"
          label="Deutsch"
        />
        Ihr Browser unterstützt das Video-Element nicht.
      </video>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-6">Streckenrekorde</h2>
    <div class="bg-white p-6 rounded-lg shadow-md overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="py-2 pr-4 font-semibold text-gray-700">Strecke</th>
            <th class="py-2 pr-4 font-semibold text-gray-700">Rekordhalter*in</th>
            <th class="py-2 pr-4 font-semibold text-gray-700">Zeit</th>
            <th class="py-2 font-semibold text-gray-700">Datum</th>
          </tr>
        </thead>
        <tbody>
          {streckenrekorde.map((r) => (
            <tr class="border-b border-gray-100 last:border-0">
              <td class="py-2 pr-4 font-medium">{r.strecke}</td>
              <td class="py-2 pr-4">{r.name}</td>
              <td class="py-2 pr-4 tabular-nums">{r.zeit}</td>
              <td class="py-2 tabular-nums">{r.datum}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-6">Anmeldung</h2>
    <div class="bg-white p-6 rounded-lg shadow-md">
      <p class="text-gray-700 mb-4">
        Die Online-Anmeldung läuft über raceresult.com. Für Fragen rund um die Anmeldung,
        die Familien- oder Team-Wertung schreibt uns gerne eine E-Mail.
      </p>
      <div class="flex flex-wrap gap-3">
        <Button href={anmeldungUrl} size="sm" rel="noopener" target="_blank">
          Jetzt online anmelden →
        </Button>
        <a
          href={anmeldungMail}
          class="inline-block bg-white border border-primary text-primary hover:bg-primary hover:text-white font-bold py-2 px-4 rounded transition-colors"
        >
          Per E-Mail Kontakt aufnehmen
        </a>
      </div>
    </div>
  </section>

  <section class="bg-primary text-white p-8 rounded-lg text-center">
    <h2 class="text-2xl md:text-3xl font-bold mb-2">
      Macht mit und erlebt den Disibodenberglauf
    </h2>
    <p class="text-lg">sportlich, familiär und mit tollen Sonderpreisen!</p>
  </section>
</Layout>
