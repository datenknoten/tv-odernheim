---
import { getCollection, getEntry, render } from "astro:content";
import StatusBadge from "../../components/StatusBadge.astro";
import Layout from "../../layouts/Layout.astro";
import { formatEventDate } from "../../lib/events";

export const prerender = true;

export async function getStaticPaths() {
	const entries = await getCollection("events");
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const entry = Astro.props.entry ?? (await getEntry("events", Astro.params.slug!));
if (!entry) return Astro.redirect("/404");
const { Content } = await render(entry);
const dateLabel = formatEventDate(entry);
---

<Layout title={`${entry.data.title} - Termin`}>
  <article class="container mx-auto px-4 py-8">
    <div class="max-w-3xl mx-auto">
      <header class="mb-8">
        <div class="flex items-center gap-3 mb-2">
          <time class="text-primary font-semibold">{dateLabel}</time>
          <StatusBadge status={entry.data.status} />
        </div>
        <h1 class="text-4xl font-bold mb-4">{entry.data.title}</h1>
        <p class="text-xl text-gray-600 mb-2">{entry.data.description}</p>
        {entry.data.location && (
          <p class="text-gray-600">📍 {entry.data.location}</p>
        )}
        {entry.data.status === "verschoben" && entry.data.originalDate && (
          <p class="text-sm text-yellow-800 mt-3 bg-yellow-50 border border-yellow-200 p-3 rounded">
            Ursprünglich geplant für {entry.data.originalDate}, verschoben auf {dateLabel}.
          </p>
        )}
      </header>

      <div class="prose prose-lg max-w-none">
        <Content />
      </div>

      {entry.data.link && (
        <div class="mt-6">
          <a
            href={entry.data.link}
            class="inline-block bg-primary hover:bg-secondary text-white font-bold py-2 px-4 rounded transition-colors"
          >
            Weitere Informationen
          </a>
        </div>
      )}

      <div class="mt-8">
        <a
          href="/termine"
          class="inline-block text-primary hover:text-secondary font-semibold"
        >
          ← Zurück zu allen Terminen
        </a>
      </div>
    </div>
  </article>
</Layout>
