---
import { getCollection, getEntry, render } from "astro:content";
import Button from "../../components/Button.astro";
import Hero from "../../components/Hero.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import Layout from "../../layouts/Layout.astro";
import { formatEventDate } from "../../lib/events";

export const prerender = true;

export async function getStaticPaths() {
	const entries = await getCollection("events");
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { slug } = Astro.params;
const entry = Astro.props.entry ?? (slug ? await getEntry("events", slug) : undefined);
if (!entry) return Astro.redirect("/404");
const { Content } = await render(entry);
const dateLabel = formatEventDate(entry);
---

<Layout
  title={`${entry.data.title} - Termin`}
  breadcrumbs={[
    { label: "Startseite", href: "/" },
    { label: "Aktuelles", href: "/aktuelles/" },
    { label: entry.data.title },
  ]}
>
  <Hero title={entry.data.title} lede={entry.data.description}>
    <Fragment slot="eyebrow">
      <time class="text-sm font-semibold uppercase tracking-widest text-accent">{dateLabel}</time>
      <StatusBadge status={entry.data.status} />
    </Fragment>
    {entry.data.location && (
      <p class="mt-4 text-gray-600">📍 {entry.data.location}</p>
    )}
    {entry.data.status === "verschoben" && entry.data.originalDate && (
      <p class="mt-4 text-sm text-yellow-800 bg-yellow-50 border border-yellow-200 p-3 rounded">
        Ursprünglich geplant für {entry.data.originalDate}, verschoben auf {dateLabel}.
      </p>
    )}
  </Hero>

  <div class="max-w-3xl">
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    {entry.data.link && (
      <div class="mt-6">
        <Button href={entry.data.link} size="sm">Weitere Informationen</Button>
      </div>
    )}

    <div class="mt-8">
      <Button href="/aktuelles" variant="link">← Zurück zur Übersicht</Button>
    </div>
  </div>
</Layout>
