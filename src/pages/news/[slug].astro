---
import { getCollection, getEntry, render } from "astro:content";
import Attachments from "../../components/Attachments.astro";
import Button from "../../components/Button.astro";
import Hero from "../../components/Hero.astro";
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

export async function getStaticPaths() {
  const newsEntries = await getCollection("news");
  return newsEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { slug } = Astro.params;
const entry = Astro.props.entry ?? (slug ? await getEntry("news", slug) : undefined);
if (!entry) return Astro.redirect("/404");
const { Content } = await render(entry);
const dateLabel = new Date(entry.data.date).toLocaleDateString("de-DE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  title={`${entry.data.title} - TV Odernheim`}
  breadcrumbs={[
    { label: "Startseite", href: "/" },
    { label: "Aktuelles", href: "/aktuelles/" },
    { label: entry.data.title },
  ]}
>
  <Hero eyebrow={dateLabel} title={entry.data.title} lede={entry.data.description} />

  <div class="max-w-3xl">
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    <Attachments attachments={entry.data.attachments} />

    <div class="mt-8">
      <Button href="/" variant="link">← Zurück zur Übersicht</Button>
    </div>
  </div>
</Layout>
