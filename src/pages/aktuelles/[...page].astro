---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import Button from "../../components/Button.astro";
import EventCard from "../../components/EventCard.astro";
import FeedCard from "../../components/FeedCard.astro";
import Hero from "../../components/Hero.astro";
import Layout from "../../layouts/Layout.astro";
import { partitionEvents } from "../../lib/events";

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
	const news = await getCollection("news");
	news.sort((a, b) => b.data.date.localeCompare(a.data.date));
	return paginate(news, { pageSize: 6 });
};

interface Props {
	page: Page<CollectionEntry<"news">>;
}

const { page } = Astro.props;

const events = await getCollection("events");
const { upcoming, past } = partitionEvents(events);

const isFirstPage = page.currentPage === 1;
---

<Layout title="Aktuelles">
  <Hero
    title="Aktuelles"
    lede="Nachrichten und Termine aus dem Vereinsleben des TV Odernheim."
  >
    <div class="mt-8">
      <Button href="/termine.ics" size="sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Termine als Kalender abonnieren (.ics)
      </Button>
    </div>
  </Hero>

  {isFirstPage && (
    <section class="mb-16">
      <div class="flex items-baseline justify-between mb-6 flex-wrap gap-2">
        <h2 class="text-3xl font-bold">Termine</h2>
        {past.length > 0 && (
          <Button href="/termine/archiv" variant="link">Archiv →</Button>
        )}
      </div>
      {upcoming.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {upcoming.map((event) => <EventCard event={event} />)}
        </div>
      ) : (
        <p class="text-gray-600">
          Aktuell sind keine kommenden Termine geplant.
          {past.length > 0 && (
            <> Vergangene Termine findest du im <a href="/termine/archiv" class="text-primary hover:text-secondary font-semibold">Archiv</a>.</>
          )}
        </p>
      )}
    </section>
  )}

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-6">Nachrichten</h2>
    {page.data.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {page.data.map((entry) => (
          <FeedCard item={{ kind: "news", date: entry.data.date, entry }} />
        ))}
      </div>
    ) : (
      <p class="text-gray-600">Zurzeit gibt es keine Nachrichten.</p>
    )}

    {page.lastPage > 1 && (
      <nav class="flex items-center justify-between mt-12" aria-label="Seitennavigation">
        {page.url.prev ? (
          <Button href={page.url.prev} size="sm">← Neuere</Button>
        ) : (
          <span></span>
        )}
        <span class="text-gray-600">
          Seite {page.currentPage} von {page.lastPage}
        </span>
        {page.url.next ? (
          <Button href={page.url.next} size="sm">Ältere →</Button>
        ) : (
          <span></span>
        )}
      </nav>
    )}
  </section>
</Layout>
