---
import { getCollection } from "astro:content";
import AnnouncementCard from "../components/AnnouncementCard.astro";
import Layout from "../layouts/Layout.astro";

const all = await getCollection("announcements");
const sorted = all.toSorted((a, b) => a.data.sortierung - b.data.sortierung);
---

<Layout title="Mitmachen & Hinweise">
  <section class="mb-12">
    <h1 class="text-4xl font-bold mb-4">Mitmachen & Hinweise</h1>
    <p class="text-xl text-gray-600 mb-8">
      Hier findet ihr unsere offenen Aufrufe, Kooperationen und allgemeinen Hinweise rund um den Verein.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sorted.map((item) => <AnnouncementCard announcement={item} />)}
    </div>
  </section>
</Layout>
