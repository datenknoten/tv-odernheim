---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import silhouette from "../assets/board/silhouette-neutral.jpg";
import Button from "../components/Button.astro";
import Hero from "../components/Hero.astro";
import { siteConfig } from "../config/site";
import Layout from "../layouts/Layout.astro";

const boardMembers = await getCollection("board");

const boardMembersWithPhotos = (
  await Promise.all(
    boardMembers.map(async (member) => ({
      ...member,
      // Der Markdoc-Body ist optional – nur gefuellte Texte werden gerendert,
      // damit im Keystatic-Admin eingegebene Inhalte auch sichtbar sind.
      Content: member.body?.trim() ? (await render(member)).Content : undefined,
      data: {
        ...member.data,
        // Unbesetzte Positionen und Mitglieder ohne Foto bekommen die
        // neutrale Silhouette.
        photo: member.data.photo ?? silhouette,
        isVacant: member.data.name === "NN",
      },
    })),
  )
).toSorted((a, b) => a.data.sortierung - b.data.sortierung);
---

<Layout
  title="Über uns"
  breadcrumbs={[
    { label: "Startseite", href: "/" },
    { label: "Über uns" },
  ]}
>
  <Hero
    title="Über den TV Odernheim"
    lede="Der Turnverein Odernheim ist ein traditionsreicher Sportverein mit einer langen Geschichte. Seit unserer Gründung setzen wir uns für die sportliche und soziale Entwicklung unserer Mitglieder ein."
  />

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-6">Geschichte</h2>
    <div class="bg-white p-6 rounded-lg shadow-md">
      <p class="text-gray-700 mb-4">
        Der TV Odernheim wurde im Jahr 1950 gegründet und hat sich seitdem zu einem der wichtigsten Sportvereine
        in der Region entwickelt. Was mit einer kleinen Gruppe von Turnern begann, ist heute ein moderner
        Sportverein mit einem breiten Angebot an Kursen und Aktivitäten.
      </p>
      <p class="text-gray-700">
        Über die Jahre haben wir uns stetig weiterentwickelt und unser Angebot erweitert. Heute bieten wir
        nicht nur klassisches Turnen, sondern auch moderne Fitnesskurse, Yoga und verschiedene andere
        Sportarten an.
      </p>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-6">Vorstand</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {boardMembersWithPhotos.map(({ data, Content }) => (
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
          <div class="flex flex-col md:flex-row">
            <div class="md:w-1/3">
              <Image
                src={data.photo}
                alt={data.isVacant ? `Unbesetzte Position: ${data.position}` : data.name}
                width={780}
                height={780}
                class="w-full h-48 md:h-full object-cover"
                sizes="(min-width: 768px) 17vw, 100vw"
              />
            </div>
            <div class="p-6 md:w-2/3">
              <p class="text-primary font-semibold mb-2">{data.position}</p>
              {data.isVacant ? (
                <>
                  <h3 class="text-xl font-bold mb-2">Position aktuell unbesetzt</h3>
                  <p class="text-gray-700 mb-3">Interesse mitzumachen? Wir freuen uns auf eine Nachricht.</p>
                  <Button href={`mailto:${siteConfig.contact.email}?subject=${encodeURIComponent('Interesse: ' + data.position)}`} variant="link">Jetzt mitmachen →</Button>
                </>
              ) : (
                <>
                  <h3 class="text-xl font-bold mb-2">{data.name}</h3>
                  {data.email && (
                    <a href={`mailto:${data.email}`} class="text-gray-600 hover:text-primary">
                      {data.email}
                    </a>
                  )}
                  {Content && (
                    <div class="prose prose-sm max-w-none mt-3">
                      <Content />
                    </div>
                  )}
                </>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-6">Unsere Philosophie</h2>
    <div class="bg-white p-6 rounded-lg shadow-md">
      <p class="text-gray-700 mb-4">
        Unser Ziel ist es, allen Mitgliedern die Möglichkeit zu bieten, sich sportlich zu betätigen und
        dabei Spaß zu haben. Wir legen besonderen Wert auf:
      </p>
      <ul class="list-disc list-inside text-gray-700 space-y-2">
        <li>Qualitativ hochwertiges Training durch ausgebildete Übungsleiter</li>
        <li>Ein breites Angebot für alle Altersgruppen</li>
        <li>Gemeinschaft und Zusammenhalt</li>
        <li>Gesundheit und Wohlbefinden</li>
        <li>Nachhaltige Entwicklung des Vereins</li>
      </ul>
    </div>
  </section>

  <section class="bg-gray-100 p-6 rounded-lg">
    <h2 class="text-2xl font-bold mb-4">Mitglied werden</h2>
    <p class="text-gray-700 mb-4">
      Interessieren Sie sich für eine Mitgliedschaft im TV Odernheim? Wir freuen uns über jedes neue Mitglied!
      Kontaktieren Sie uns für weitere Informationen oder besuchen Sie uns während unserer Geschäftszeiten.
    </p>
    <Button href={`mailto:${siteConfig.contact.email}?subject=${encodeURIComponent('Mitgliedsantrag')}`} size="sm">Jetzt Mitglied werden</Button>
  </section>
</Layout>
