---
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";

export const prerender = true;

export async function getStaticPaths() {
	const entries = await getCollection("announcements");
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { slug } = Astro.params;
const entry = Astro.props.entry ?? (slug ? await getEntry("announcements", slug) : undefined);
if (!entry) return Astro.redirect("/404");
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} - TV Odernheim`}>
  <article class="container mx-auto px-4 py-8">
    <div class="max-w-3xl mx-auto">
      {entry.data.image && (
        <Image
          src={entry.data.image}
          alt={entry.data.title}
          width={1200}
          height={675}
          class="w-full aspect-[16/9] object-cover rounded-lg mb-8"
          format="webp"
          quality={80}
        />
      )}
      <header class="mb-8">
        <p class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">{entry.data.category}</p>
        <h1 class="text-4xl font-bold mb-4">{entry.data.title}</h1>
        <p class="text-xl text-gray-600">{entry.data.description}</p>
      </header>

      <div class="prose prose-lg max-w-none">
        <Content />
      </div>

      {entry.data.ctaLabel && entry.data.ctaUrl && (
        <div class="mt-8">
          <Button href={entry.data.ctaUrl}>{entry.data.ctaLabel}</Button>
        </div>
      )}

      <div class="mt-8">
        <Button href="/mitmachen" variant="link">← Zurück zur Übersicht</Button>
      </div>
    </div>
  </article>
</Layout>
