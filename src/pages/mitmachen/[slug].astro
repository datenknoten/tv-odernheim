---
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import Button from "../../components/Button.astro";
import Hero from "../../components/Hero.astro";
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection("announcements");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { slug } = Astro.params;
const entry = Astro.props.entry ?? (slug ? await getEntry("announcements", slug) : undefined);
if (!entry) return Astro.redirect("/404");
const { Content } = await render(entry);
---

<Layout
  title={`${entry.data.title} - TV Odernheim`}
  breadcrumbs={[
    { label: "Startseite", href: "/" },
    { label: "Mitmachen", href: "/mitmachen/" },
    { label: entry.data.title },
  ]}
>
  {entry.data.image && (
    <div class="max-w-3xl mb-8">
      <Image
        src={entry.data.image}
        alt={entry.data.title}
        width={1200}
        height={675}
        class="w-full aspect-[16/9] object-cover rounded-lg"
        sizes="(min-width: 768px) 768px, 100vw"
        format="webp"
        quality={80}
      />
    </div>
  )}

  <Hero
    eyebrow={entry.data.category}
    title={entry.data.title}
    lede={entry.data.description}
  />

  <div class="max-w-3xl">
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    {entry.data.ctaLabel && entry.data.ctaUrl && (
      <div class="mt-8">
        <Button href={entry.data.ctaUrl}>{entry.data.ctaLabel}</Button>
      </div>
    )}

    <div class="mt-8">
      <Button href="/mitmachen" variant="link">← Zurück zur Übersicht</Button>
    </div>
  </div>
</Layout>
