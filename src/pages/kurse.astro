---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection } from "astro:content";
import BookableCourseCard from "../components/BookableCourseCard.astro";
import Button from "../components/Button.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { siteConfig } from "../config/site";
import Layout from "../layouts/Layout.astro";
import {
  type Course,
  fetchCourses,
  INTELLIVEREIN_COURSE_LIST_URL,
  INTELLIVEREIN_PORTAL_URL,
} from "../lib/intelliverein";

const courses = await getCollection("courses");

// Buchbare Kurse kommen live aus dem Kursportal (IntelliVerein). Faellt die
// Schnittstelle aus, darf daran weder der Build noch der Rest der Seite
// haengen: dann steht hier nur der Verweis auf die Kursliste im Portal.
let bookableCourses: Course[] = [];
let bookableCoursesFailed = false;
try {
  bookableCourses = await fetchCourses();
} catch (error) {
  bookableCoursesFailed = true;
  console.warn(`[kurse] Kursliste aus IntelliVerein nicht abrufbar: ${error}`);
}

type Category = CollectionEntry<"courses">["data"]["category"];

const categoryOrder: Category[] = [
  "Kinderturnen",
  "Gymnastik, Fitness, Gesundheit, Kurse",
  "Sportarten",
];

const coursesByCategory = courses.reduce<Record<Category, CollectionEntry<"courses">[]>>(
  (acc, course) => {
    const { category } = course.data;
    if (!acc[category]) {
      acc[category] = [];
    }
    acc[category].push(course);
    return acc;
  },
  {} as Record<Category, CollectionEntry<"courses">[]>,
);
---

<Layout
  title="Kurse"
  breadcrumbs={[
    { label: "Startseite", href: "/" },
    { label: "Kurse" },
  ]}
>
  <Hero
    title="Unsere Kurse"
    lede="Entdecke unser vielfältiges Kursangebot – Kurse für alle Altersgruppen und jedes Fitnesslevel."
  >
    <p class="mt-6 text-lg text-gray-700 leading-relaxed">
      Interesse an einem Kurs? Komm einfach vorbei und mach mit – die Übungsleiterinnen
      und Übungsleiter freuen sich auf dich.
    </p>
    <p class="mt-4 text-lg text-gray-700 leading-relaxed">
      Noch kein Mitglied? Kein Problem: Probier den Kurs erst einmal in Ruhe aus. Wenn
      es dir gefällt, wirst du Mitglied.
    </p>
  </Hero>

  {categoryOrder.map(category => (
    <div class="mb-12">
      <h2 class="text-3xl font-bold mb-6">{category}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {coursesByCategory[category]?.map(course => (
          <div class="bg-white rounded-lg shadow-md overflow-hidden flex flex-col">
            {course.data.image ? (
              <Image
                src={course.data.image}
                alt={course.data.title}
                width={800}
                height={450}
                class="w-full aspect-[16/9] object-cover"
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                format="webp"
                quality={80}
              />
            ) : (
              <div
                class="w-full aspect-[16/9] bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center"
                aria-hidden="true"
              >
                <img
                  src="/images/tvo-logo-red.png"
                  alt=""
                  width="72"
                  height="72"
                  class="opacity-40"
                  loading="lazy"
                />
              </div>
            )}
            <div class="p-6 flex flex-col flex-1">
              <h3 class="text-2xl font-bold mb-2">{course.data.title}</h3>
              <p class="text-gray-600 mb-4">{course.data.description}</p>
              <div class="space-y-2">
                <p class="flex items-center">
                  <svg class="w-5 h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {course.data.schedule}
                </p>
                {course.data.location && (
                  <p class="flex items-center">
                    <svg class="w-5 h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    {course.data.location}
                  </p>
                )}
                {course.data.instructor && (
                  <p class="flex items-center">
                    <svg class="w-5 h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    {course.data.instructor}
                  </p>
                )}
              </div>
              <Button href={`mailto:${siteConfig.contact.email}?subject=${encodeURIComponent(`Anmeldung: ${course.data.title}`)}`} size="sm" class="mt-4 self-start">Jetzt anmelden</Button>
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}

  {(bookableCourses.length > 0 || bookableCoursesFailed) && (
    <section class="mb-12">
      <SectionHeading
        eyebrow="Anmeldung über das Kursportal"
        title="Kurse mit fester Laufzeit"
        lede="Schwimmkurse, Ferienangebote und Lehrgänge mit begrenzter Teilnehmerzahl – Anmeldung direkt im Nutzerportal des Vereins."
        class="mb-6"
      />
      {/* {" "} nach der Textzeile: in einem Ausdruck schluckt Astro den
          Zeilenumbruch vor einem Element wie JSX — sonst klebt „imKursportal“. */}
      {bookableCoursesFailed ? (
        <p class="text-gray-700">
          Die Kursliste ist gerade nicht abrufbar. Alle buchbaren Kurse stehen im{" "}
          <a class="font-semibold text-primary hover:text-secondary" href={INTELLIVEREIN_COURSE_LIST_URL}>Kursportal</a>.
        </p>
      ) : (
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
          {bookableCourses.map(course => <BookableCourseCard course={course} />)}
        </div>
      )}
      <p class="mt-6 text-sm text-gray-600">
        Für die Anmeldung ist ein Benutzerkonto nötig. Mitglieder nutzen im{" "}
        <a class="font-semibold text-primary hover:text-secondary" href={INTELLIVEREIN_PORTAL_URL}>Nutzerportal</a>{" "}
        den Link „Passwort anfordern für Mitglieder“, damit die ermäßigte Gebühr erkannt wird.
      </p>
    </section>
  )}

  <section class="bg-gray-100 p-6 rounded-lg">
    <h2 class="text-2xl font-bold mb-4">Anmeldung und Informationen</h2>
    <p class="text-gray-700 mb-4">
      Für die Anmeldung zu einem Kurs oder bei Fragen sind wir gerne für dich da.
      Schreib uns eine E-Mail oder ruf während unserer Geschäftszeiten an.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <h3 class="font-bold mb-2">Geschäftszeiten</h3>
        <p>Montag - Freitag: 9:00 - 12:00 Uhr</p>
        <p>Montag - Donnerstag: 14:00 - 17:00 Uhr</p>
      </div>
      <div>
        <h3 class="font-bold mb-2">Kontakt</h3>
        <p>Telefon: {siteConfig.contact.phone}</p>
        <p>E-Mail: {siteConfig.contact.email}</p>
      </div>
    </div>
  </section>
</Layout>