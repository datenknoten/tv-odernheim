---
import { siteConfig } from "../config/site";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Impressum"
  breadcrumbs={[
    { label: "Startseite", href: "/" },
    { label: "Impressum" },
  ]}
>
  <section class="max-w-3xl mx-auto">
    <h1 class="text-4xl font-bold mb-8">Impressum</h1>

    <div class="bg-white p-6 rounded-lg shadow-md mb-8">
      <h2 class="text-2xl font-bold mb-4">Angaben gemäß § 5 DDG</h2>
      <p class="mb-4">
        {siteConfig.name}<br />
        {siteConfig.address.street}<br />
        {siteConfig.address.zip} {siteConfig.address.city}
      </p>

      <h2 class="text-2xl font-bold mb-4">Kontakt</h2>
      <p class="mb-4">
        Telefon: {siteConfig.contact.phone}<br />
        E-Mail: {siteConfig.contact.email}
      </p>

      <h2 class="text-2xl font-bold mb-4">Vertretungsberechtigter Vorstand nach § 26 BGB</h2>
      <p class="mb-4">
        {siteConfig.legal.responsiblePerson.name}<br />
        {siteConfig.legal.responsiblePerson.position}
      </p>

      <h2 class="text-2xl font-bold mb-4">Registereintrag</h2>
      <p class="mb-4">
        Eintragung im Vereinsregister<br />
        Registergericht: {siteConfig.legal.register.court}<br />
        Registernummer: {siteConfig.legal.register.number}
      </p>

      <h2 class="text-2xl font-bold mb-4">Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
      <p class="mb-4">
        {siteConfig.legal.responsiblePerson.name}<br />
        {siteConfig.address.street}<br />
        {siteConfig.address.zip} {siteConfig.address.city}
      </p>

      <h2 class="text-2xl font-bold mb-4">Technische Implementierung</h2>
      <p class="mb-4">
        <a href="https://datenknoten.me" class="text-primary hover:text-secondary">
          Datenknoten IT Dienstleistungen Tim Schumacher
        </a>
      </p>
    </div>

    <div class="bg-gray-100 p-6 rounded-lg">
      <h2 class="text-2xl font-bold mb-4">Haftungshinweis</h2>
      <p>
        Trotz sorgfältiger Erarbeitung der Inhalte übernehmen wir keine Gewähr und Haftung für
        die Richtigkeit, Zuverlässigkeit, Vollständigkeit und Aktualität der Informationen.
        Ebenso übernehmen wir keine Haftung für die Inhalte externer Links. Für den Inhalt der
        verlinkten Seiten sind ausschließlich deren Betreiber verantwortlich.
      </p>
    </div>
  </section>
</Layout>