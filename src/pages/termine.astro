---
import { getCollection } from "astro:content";
import EventCard from "../components/EventCard.astro";
import Layout from "../layouts/Layout.astro";
import { partitionEvents } from "../lib/events";

const all = await getCollection("events");
const { upcoming, past } = partitionEvents(all);
---

<Layout title="Termine">
  <section class="mb-12">
    <h1 class="text-4xl font-bold mb-4">Termine</h1>
    <p class="text-xl text-gray-600 mb-6">
      Eine Übersicht über kommende und vergangene Termine des TV Odernheim.
    </p>

    <a
      href="/termine.ics"
      class="inline-flex items-center gap-2 mb-8 bg-primary hover:bg-secondary text-white font-bold py-2 px-4 rounded transition-colors"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      Kalender abonnieren (.ics)
    </a>

    <h2 class="text-3xl font-bold mb-6">Nächste Termine</h2>
    {upcoming.length === 0 ? (
      <p class="text-gray-600 italic mb-8">Aktuell sind keine Termine geplant.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        {upcoming.map((event) => <EventCard event={event} />)}
      </div>
    )}

    {past.length > 0 && (
      <details class="mt-8">
        <summary class="cursor-pointer text-2xl font-bold text-gray-700 hover:text-primary mb-4 select-none">
          Vergangene Termine ({past.length})
        </summary>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
          {past.map((event) => <EventCard event={event} compact />)}
        </div>
      </details>
    )}
  </section>
</Layout>
